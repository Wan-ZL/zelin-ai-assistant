config.yaml
config/secrets/
config/redaction_terms.txt
# runtime registry entries contain real extracted work data — never commit them
# (the archive/ subdir too: archived cards are the same real data, and the
# R-*.yaml pattern does not reach into subdirectories)
# (v2.0.0: the registry retired with §1 and its fictional example card was removed;
# the patterns stay so a 1.x checkout's leftover real cards never get committed)
act/registry/R-*.yaml
act/registry/archive/
*.log
.DS_Store
state/
shell/build/
# mac/ was removed in v2.0.0; its build outputs (mac/build/, mac/LogicTests/.build/,
# the vendored mac/Frameworks/) may still sit in a 1.x checkout — keep them ignored.
mac/build/
mac/LogicTests/.build/
mac/Frameworks/
__pycache__/
*.pyc
config/runtime.json
supabase/.temp/
promo/build/
promo/node_modules/
promo/package.json
promo/package-lock.json
.coverage
# Release bundles built on the release runner (the 1.x portable packager
# scripts/package-portable.sh retired in v2.0.0); never committed (防腐 #4).
dist/

# QA instrument outputs (mutation state/reports — CONTRACT §57; 防腐 #4:
# data files are born gitignored, never inside a package)
.qa/

# QA gate outputs (scripts/qa/run_gates.sh; CONTRACT §58) — verdicts, coverage
# JSON and suggested baselines land here; the committed truth lives in qa/
.qa-report/

# test-code / test-ui skill run outputs — the repo copies of those skills (and the
# .test-code/baselines/ ledgers) retired in v2.0.0; old run dirs stay ignored
.test-code/
.test-ui/

# Playwright MCP browser-debug dumps (never commit)
.playwright-mcp/

# Generated version stamp (CONTRACT §56.1): scripts/version_stamp.py writes it
# from the git tag at install/build/release time; the tag is the truth, never a
# committed file.
act/_version.py

# Claude Code's own runtime files under the project .claude/ (bg-session
# worktrees, locks, local settings) never enter the repo. (Until v2.0.0 the
# .claude/skills/ symlinks into the skill store were tracked; they left with
# skills/ and §67.)
.claude/*

# 报告产物目录（scripts/qa/readme_audit.py --out 的默认落点；v2.0.0 前也是全覆盖跑者
# full_coverage.sh 的报告目录，那条跑者随 §77 退役）——产物，不进仓库。
qa/coverage-report/

# hypothesis example database (test cache; was committed by accident in a514b402)
.hypothesis/
