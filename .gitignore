config.yaml
config/secrets/
config/redaction_terms.txt
# runtime registry entries contain real extracted work data — never commit them
# (the archive/ subdir too: archived cards are the same real data, and the
# R-*.yaml pattern does not reach into subdirectories)
act/registry/R-*.yaml
act/registry/archive/
!act/registry/R-000-example.yaml
*.log
.DS_Store
state/
mac/build/
shell/build/
# SwiftPM build dir of the logic-test package (mac/LogicTests/test.sh)
mac/LogicTests/.build/
# Sparkle.framework + bin/ tools — vendored on demand by mac/scripts/fetch-sparkle.sh,
# never committed (~30 MB binary; build.sh works fine without it).
mac/Frameworks/
__pycache__/
*.pyc
config/runtime.json
supabase/.temp/
promo/build/
promo/node_modules/
promo/package.json
promo/package-lock.json
.coverage
# Portable release bundles (scripts/package-portable.sh, CONTRACT §56.2) — the
# built .zip / .tar.gz assets, produced on the release runner and uploaded to
# the GitHub Release; never committed (防腐 #4: born gitignored).
dist/

# QA instrument outputs (mutation state/reports — CONTRACT §57; 防腐 #4:
# data files are born gitignored, never inside a package)
.qa/

# QA gate outputs (scripts/qa/run_gates.sh; CONTRACT §58) — verdicts, coverage
# JSON and suggested baselines land here; the committed truth lives in qa/
.qa-report/

# test-code skill run outputs (skills/test-code; vnext2-plan R2.8) — reports are
# per-run artifacts; .test-code/baselines/ (shrink-only ledgers) stays committed
.test-code/reports/

# Playwright MCP browser-debug dumps (never commit)
.playwright-mcp/

# Generated version stamp (CONTRACT §56.1): scripts/version_stamp.py writes it
# from the git tag at install/build/release time; the tag is the truth, never a
# committed file.
act/_version.py

# Claude Code's own runtime files under the project .claude/ (bg-session
# worktrees, locks, local settings) never enter the repo; the ONE tracked entry
# is .claude/skills/ — relative symlinks that make the default_enabled store
# skills project-visible to every session and dispatched agent (CONTRACT §67).
.claude/*
!.claude/skills/

# test-ui skill run outputs (skills/test-ui; vnext2-plan R2.8) — reports and the detached reference
# worktrees are per-run artifacts; the ledgers it reads live in ui/parity/ and stay committed
.test-ui/reports/
.test-ui/cache/

# 全覆盖跑者的报告 R 与每场景日志（scripts/qa/full_coverage.sh，CONTRACT §58）——
# 每跑一次都重写、体积随日志涨；真源是清单 qa/coverage_inventory.json + 跑一次的命令，
# 报告本身是产物（要留档时由 integrator 拷去 media 卷）。
qa/coverage-report/
