<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  TEMPLATE: install.sh renders the /Users/YOURUSERNAME placeholders (python,
  repo root, $HOME) into ~/Library/LaunchAgents — do not load this file as-is.

  slackradar — captures Slack DMs / group DMs / watched-channel @mentions and
  turns the actionable ones into requirement cards (draft-only for comms).

  SAFE UNDER LAUNCHD: this radar only touches the network + ~/Projects/zelin-ai-assistant/state,
  never ~/Documents, so it is NOT TCC-blocked (unlike the Obsidian radar, which
  must use crontab). It no-ops until a Slack user token exists at the path in
  config (sources.slack_token_path, default ~/Desktop/Keys/slack-user-token.txt).

  TOKEN: needs a Slack **user token** (xoxp-) with scopes
  search:read, im:history, im:read, mpim:history, mpim:read, channels:history,
  groups:history, users:read. See docs/SLACK_SETUP.md.
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.zelin.aiassistant.slackradar</string>

    <key>ProgramArguments</key>
    <array>
        <string>/Users/YOURUSERNAME/miniconda3/bin/python3</string>
        <string>-m</string>
        <string>act.radar_slack</string>
        <string>--once</string>
    </array>

    <!-- $HOME, NEVER the repo: launchd performs chdir + log-file open
         BEFORE exec, and a repo on an external (TCC-gated) volume makes
         the spawn itself fail with EX_CONFIG (78). Module resolution
         rides PYTHONPATH in EnvironmentVariables instead. -->
    <key>WorkingDirectory</key>
    <string>/Users/YOURUSERNAME</string>

    <!-- poll every 3 minutes -->
    <key>StartInterval</key>
    <integer>180</integer>
    <key>RunAtLoad</key>
    <true/>

    <key>EnvironmentVariables</key>
    <dict>
        <key>AIASSISTANT_HOME</key>
        <string>/Users/YOURUSERNAME/Projects/zelin-ai-assistant</string>
        <!-- import path for `python3 -m act.*` now that
             WorkingDirectory no longer points at the repo -->
        <key>PYTHONPATH</key>
        <string>/Users/YOURUSERNAME/Projects/zelin-ai-assistant</string>
        <key>PATH</key>
        <string>/Users/YOURUSERNAME/.claude-bin:/opt/homebrew/bin:/opt/homebrew/sbin:/Users/YOURUSERNAME/miniconda3/bin:/Users/YOURUSERNAME/.local/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    </dict>

    <!-- fd ceiling (CONTRACT §55): a launchd gui-domain job inherits
         `ulimit -n 256`, and `claude --bg` refuses to start under it ("low
         max file descriptors") — 2026-08-31 live incident: every dispatch
         failed and the card was re-dispatched 66 times in 13h. 8192 is the
         login shell's effective ceiling; both keys must be set or launchd
         keeps the 256 hard cap and the soft raise is a no-op. -->
    <key>SoftResourceLimits</key>
    <dict>
        <key>NumberOfFiles</key>
        <integer>8192</integer>
    </dict>
    <key>HardResourceLimits</key>
    <dict>
        <key>NumberOfFiles</key>
        <integer>8192</integer>
    </dict>

    <!-- ~/Library/Logs, NEVER under the repo — same spawn-time rule as
         WorkingDirectory above (launchd opens these paths pre-exec). -->
    <key>StandardOutPath</key>
    <string>/Users/YOURUSERNAME/Library/Logs/zelin-ai-assistant/slackradar.launchd.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/YOURUSERNAME/Library/Logs/zelin-ai-assistant/slackradar.launchd.log</string>
</dict>
</plist>
