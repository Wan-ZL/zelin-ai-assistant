<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleExecutable</key>
	<string>ZelinAIEngineer</string>
	<key>CFBundleIdentifier</key>
	<string>com.zelin.ai-engineer</string>
	<!-- §54 name swap (owner 2026-09-02): the board shell is "Zelin's AI
	     Assistant"; this frozen menu-bar app reads "(old)" everywhere it shows a
	     name. Stamped HERE, at build time, so the value sits inside the code
	     signature seal — installed bundles are never edited (tccd validates the
	     seal on every request). Executable, bundle id and the signing identity
	     stay exactly as they are: they are what the TCC grants key on (§12). -->
	<key>CFBundleName</key>
	<string>Zelin's AI Assistant (old)</string>
	<key>CFBundleDisplayName</key>
	<string>Zelin's AI Assistant (old)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleIconFile</key>
	<string>AppIcon</string>
	<key>CFBundleIconName</key>
	<string>AppIcon</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<!-- Fallback only: mac/build.sh stamps both version keys into the staged
	     bundle from the git tag (scripts/version_stamp.py, CONTRACT §56.1) at
	     build time. Nobody bumps a version anywhere. -->
	<key>CFBundleShortVersionString</key>
	<string>0.11.0</string>
	<key>CFBundleVersion</key>
	<string>0.11.0</string>
	<key>LSApplicationCategoryType</key>
	<string>public.app-category.productivity</string>
	<key>LSUIElement</key>
	<true/>
	<key>LSMinimumSystemVersion</key>
	<string>14.0</string>
	<key>NSHumanReadableCopyright</key>
	<string>Copyright © 2026 Zelin. All rights reserved.</string>
	<key>NSPrincipalClass</key>
	<string>NSApplication</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>「屏幕 + 音频」录制模式需要麦克风来转录会议与语音，数据只存本地 ~/.screenpipe。</string>
	<key>NSAppleEventsUsageDescription</key>
	<string>双击卡片上的 claude 命令时，需要控制所选终端（Ghostty / Terminal / iTerm2）来新开窗口运行它。</string>
	<!-- Sparkle auto-update — DISARMED (CONTRACT §74.3; D3 froze this bundle,
	     issue #333). It used to fetch an EdDSA-signed .pkg from the newest GitHub
	     Release and install it unattended; on 2026-09-07 it did exactly that with
	     an OLDER release, and that payload's postinstall rsynced tag v1.0.14 over
	     the live checkout (232 tracked files reverted, actd restarted). Frozen
	     must mean inert, so both automatic switches are false here and the
	     published feed itself carries no items (release.yml). SUFeedURL and
	     SUPublicEDKey stay so a hand-driven 「检查更新」 still parses a real,
	     well-formed feed and decides locally that there is nothing to install,
	     instead of failing on a 404 — and so re-arming this is a two-line
	     change rather than an archaeology dig.
	     ALREADY-INSTALLED bundles keep the old 「true」 values: their Info.plist is
	     inside the code-signing seal and must never be edited (§54) — the terminal
	     feed is what disarms those. -->
	<key>SUFeedURL</key>
	<string>https://github.com/Wan-ZL/zelin-ai-assistant/releases/latest/download/appcast.xml</string>
	<key>SUPublicEDKey</key>
	<string>VAVks5YGb78Nt7ntPLx3CxXLZ3cLUaopWsQfJXZBFmI=</string>
	<key>SUEnableAutomaticChecks</key>
	<false/>
	<key>SUScheduledCheckInterval</key>
	<integer>86400</integer>
	<key>SUAutomaticallyUpdate</key>
	<false/>
</dict>
</plist>
