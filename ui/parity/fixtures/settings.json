          "help": {
            "en": "basic / detailed are both metadata-only granularity; basic also switches off typed-text upload.",
            "zh": "basic / detailed 都只是元数据粒度；切 basic 同时停掉输入文本上传。"
          },
          "key": "telemetry.level",
          "kind": "enum",
