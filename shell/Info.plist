<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleExecutable</key>
	<string>ZelinAIBoard</string>
	<key>CFBundleIdentifier</key>
	<string>com.zelin.ai-board</string>
	<!-- Names (CONTRACT §54; owner 2026-09-02): this shell IS the product, so
	     the bundle folder and every visible name read "Zelin's AI Assistant";
	     the legacy menu-bar app moved to "Zelin's AI Assistant (old)". The id
	     deliberately stays com.zelin.ai-board — a TCC identity separate from
	     the legacy com.zelin.ai-engineer, whose grants (Screen Recording,
	     Microphone, Documents) stay with the legacy app until P8; two bundles
	     sharing one id would fight over LaunchServices registration and TCC
	     attribution. -->
	<key>CFBundleName</key>
	<string>Zelin's AI Assistant</string>
	<key>CFBundleDisplayName</key>
	<string>Zelin's AI Assistant</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleIconFile</key>
	<string>AppIcon</string>
	<key>CFBundleIconName</key>
	<string>AppIcon</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<!-- Fallback only: shell/build.sh stamps both version keys from the git
	     tag (scripts/version_stamp.py, CONTRACT §56.1), same as mac/build.sh. -->
	<key>CFBundleShortVersionString</key>
	<string>0.1.0</string>
	<key>CFBundleVersion</key>
	<string>0.1.0</string>
	<key>LSApplicationCategoryType</key>
	<string>public.app-category.productivity</string>
	<key>LSMinimumSystemVersion</key>
	<string>14.0</string>
	<key>NSHumanReadableCopyright</key>
	<string>Copyright © 2026 Zelin. All rights reserved.</string>
	<key>NSPrincipalClass</key>
	<string>NSApplication</string>
	<key>NSHighResolutionCapable</key>
	<true/>
	<!-- ATS: WKWebView 只连 http://127.0.0.1:$ZAI_PORT，显式放行 localhost http。 -->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
	<!-- TCC usage descriptions（CONTRACT §61.4）：录制/字幕引擎搬进壳后，屏幕录制
	     授权按本 bundle id 归属（无 usage-description 键，系统提示由 CGRequest
	     ScreenCaptureAccess 触发）；麦克风由实时字幕的 AVCaptureDevice.requestAccess
	     首次触发，缺这个键 macOS 会直接杀进程。文案与 mac/Info.plist 同义。 -->
	<!-- §68.7（issue #216）：双击卡片在终端接管会话 = 壳经 Apple Events 控制所选终端
	     （TerminalLauncher.swift）；首次按（本 app, 终端）这一对弹一次自动化授权，此后安静。
	     缺这个键 macOS 会直接拒绝 Apple Events。文案与退役的 mac/Info.plist 同义。 -->
	<key>NSAppleEventsUsageDescription</key>
	<string>双击卡片在终端接管会话时，需要控制所选终端（Ghostty / Terminal / iTerm2）来新开窗口运行命令。</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>实时字幕与「屏幕 + 音频」录制模式需要麦克风来转录会议与语音；音频只送往你自己 key 对应的识别服务，录制数据只存本地 ~/.screenpipe。</string>
	<!-- Server repo（cwd of `python3 -m server`）。源文件留空：shell/build.sh
	     构建时以实际 repo root 盖章（同版本号机制）；未盖章 + 无 defaults 覆盖
	     时壳会礼貌报错而非猜路径。
	     可用 `defaults write com.zelin.ai-board serverRepo <path>` 覆盖。 -->
	<key>ZAIServerRepo</key>
	<string></string>
	<!-- Board server port（§54）。源文件留空 = 用 server 侧同一默认 47820；
	     install.sh 经 shell/build.sh（env ZAI_PORT）以 config.yaml server.port
	     盖章。解析序：env ZAI_PORT → defaults serverPort → 本键 → 47820。 -->
	<key>ZAIServerPort</key>
	<string></string>
</dict>
</plist>
