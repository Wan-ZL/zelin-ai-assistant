<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleExecutable</key>
	<string>ZelinAIBoard</string>
	<key>CFBundleIdentifier</key>
	<string>com.zelin.ai-board</string>
	<!-- Names (CONTRACT §54 / vnext2-plan §8): the bundle FOLDER stays
	     "Zelin AI Board.app" and the id stays com.zelin.ai-board for now
	     (TCC grants key on the id); what the user sees — Dock, window title,
	     app menu — reads as part of the product. The final swap (shell takes
	     "Zelin's AI Assistant", legacy becomes "(old)") happens at P8. -->
	<key>CFBundleName</key>
	<string>Zelin's AI Assistant (Board)</string>
	<key>CFBundleDisplayName</key>
	<string>Zelin's AI Assistant (Board)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleIconFile</key>
	<string>AppIcon</string>
	<key>CFBundleIconName</key>
	<string>AppIcon</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<!-- Fallback only: shell/build.sh stamps both version keys from
	     act/__init__.py (single source of truth), same as mac/build.sh. -->
	<key>CFBundleShortVersionString</key>
	<string>0.1.0</string>
	<key>CFBundleVersion</key>
	<string>0.1.0</string>
	<key>LSApplicationCategoryType</key>
	<string>public.app-category.productivity</string>
	<key>LSMinimumSystemVersion</key>
	<string>14.0</string>
	<key>NSHumanReadableCopyright</key>
	<string>Copyright © 2026 Zelin. All rights reserved.</string>
	<key>NSPrincipalClass</key>
	<string>NSApplication</string>
	<key>NSHighResolutionCapable</key>
	<true/>
	<!-- ATS: WKWebView 只连 http://127.0.0.1:$ZAI_PORT，显式放行 localhost http。 -->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
	<!-- TCC usage descriptions（CONTRACT §61.4）：录制/字幕引擎搬进壳后，屏幕录制
	     授权按本 bundle id 归属（无 usage-description 键，系统提示由 CGRequest
	     ScreenCaptureAccess 触发）；麦克风由实时字幕的 AVCaptureDevice.requestAccess
	     首次触发，缺这个键 macOS 会直接杀进程。文案与 mac/Info.plist 同义。 -->
	<key>NSMicrophoneUsageDescription</key>
	<string>实时字幕与「屏幕 + 音频」录制模式需要麦克风来转录会议与语音；音频只送往你自己 key 对应的识别服务，录制数据只存本地 ~/.screenpipe。</string>
	<!-- Server repo（cwd of `python3 -m server`）。源文件留空：shell/build.sh
	     构建时以实际 repo root 盖章（同版本号机制）；未盖章 + 无 defaults 覆盖
	     时壳会礼貌报错而非猜路径。
	     可用 `defaults write com.zelin.ai-board serverRepo <path>` 覆盖。 -->
	<key>ZAIServerRepo</key>
	<string></string>
	<!-- Board server port（§54）。源文件留空 = 用 server 侧同一默认 47820；
	     install.sh 经 shell/build.sh（env ZAI_PORT）以 config.yaml server.port
	     盖章。解析序：env ZAI_PORT → defaults serverPort → 本键 → 47820。 -->
	<key>ZAIServerPort</key>
	<string></string>
</dict>
</plist>
